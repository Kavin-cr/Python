def cop(a,b):
    return kav(a,b)==1
def kav(a,b):
    while(b!=0):
        rem=a%b
        t=b
        b=rem
        a=t
    return a
n=int(input("Enter the number:"))
for a in range(1,n+1):
    for b in range(1,n+1):
        for c in range(1,n+1):
            if c*c+b*b==a*a and cop(a,b) and cop(b,c) and cop(a,c):
                print( c , b , a )
